# PlatePilgrim — Frontend Environment Variables
# Copy to .env.local and fill in values below for local dev.
# In production these are written to .env.production by GitHub Actions.

# Cognito Hosted UI domain — from CDK output CognitoHostedUiDomain
VITE_COGNITO_DOMAIN=https://platepilgrim.auth.ap-south-1.amazoncognito.com

# Cognito User Pool Client ID — from CDK output UserPoolClientId
VITE_COGNITO_CLIENT_ID=25klgjete6qfkek6uko5t05k7g

# API base URL — leave empty in production (CloudFront /api/* proxy handles it).
# For local dev, set this to the API Gateway endpoint:
# VITE_API_URL=https://hgte1r7jff.execute-api.ap-south-1.amazonaws.com
VITE_API_URL=

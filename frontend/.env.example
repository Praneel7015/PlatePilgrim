# PlatePilgrim — Frontend Environment Variables
# Copy to .env.local and fill in real values after `cdk deploy`

# Cognito Hosted UI domain — from CDK output CognitoHostedUiDomain
VITE_COGNITO_DOMAIN=https://platepilgrim.auth.ap-south-1.amazoncognito.com

# Cognito User Pool Client ID — from CDK output UserPoolClientId
VITE_COGNITO_CLIENT_ID=REPLACE_WITH_CLIENT_ID

# API base URL — leave empty to use CloudFront /api/* proxy in production.
# For local dev, point to the API Gateway endpoint directly:
# VITE_API_URL=https://XXXXXXXXXX.execute-api.ap-south-1.amazonaws.com
VITE_API_URL=
